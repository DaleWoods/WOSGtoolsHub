<!doctype html>
<html lang="en" class="h-full">
  <head>
    <%- include('partials/head', { title: 'Sign in' }) %>
  </head>
  <body class="flex h-full flex-col bg-gray-50 font-sans text-gray-900 dark:bg-gray-950 dark:text-gray-100">
    <%- include('partials/nav', { activeNav: '' }) %>

    <main class="mx-auto flex w-full max-w-sm flex-1 flex-col justify-center px-4 py-12">
      <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-tile dark:border-gray-700 dark:bg-gray-800">
        <h2 class="mb-4 text-center text-lg font-semibold">Sign in</h2>

        <% if (error) { %>
        <p class="mb-4 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700 dark:bg-red-900/30 dark:text-red-400">
          <%= error %>
        </p>
        <% } %>

        <form method="POST" action="/login" class="space-y-4">
          <div>
            <label for="username" class="form-label">Username</label>
            <input id="username" name="username" type="text" required autofocus class="form-input" />
          </div>
          <div>
            <label for="password" class="form-label">Password</label>
            <input id="password" name="password" type="password" required class="form-input" />
          </div>
          <button type="submit" class="btn-primary w-full">Sign in</button>
        </form>
      </div>
    </main>
  </body>
</html>
