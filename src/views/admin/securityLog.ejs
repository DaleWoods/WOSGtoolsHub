<!doctype html>
<html lang="en" class="h-full">
  <head>
    <%- include('../partials/head', { title: 'Security Log' }) %>
  </head>
  <body class="min-h-full bg-gray-50 font-sans text-gray-900 dark:bg-gray-950 dark:text-gray-100">
    <%- include('../partials/nav', { activeNav: 'admin' }) %>

    <main class="mx-auto max-w-5xl px-4 py-8">
      <%- include('../partials/adminNav', { section: 'security-log' }) %>

      <h2 class="mb-4 text-lg font-semibold">Security Log</h2>

      <form method="GET" action="/admin/security-log" class="mb-6 flex flex-wrap items-end gap-3 rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800">
        <div>
          <label for="eventType" class="form-label">Event type</label>
          <select id="eventType" name="eventType" class="form-input">
            <option value="">All</option>
            <% eventTypes.forEach(function (type) { %>
            <option value="<%= type %>" <%= filters.eventType === type ? 'selected' : '' %>><%= type %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label for="from" class="form-label">From</label>
          <input id="from" type="date" name="from" value="<%= filters.from %>" class="form-input" />
        </div>
        <div>
          <label for="to" class="form-label">To</label>
          <input id="to" type="date" name="to" value="<%= filters.to %>" class="form-input" />
        </div>
        <button type="submit" class="btn-primary">Filter</button>
        <a href="/admin/security-log" class="btn-secondary">Clear</a>
      </form>

      <div class="overflow-x-auto rounded-xl border border-gray-200 dark:border-gray-700">
        <table class="min-w-full divide-y divide-gray-200 text-sm dark:divide-gray-700">
          <thead class="bg-gray-50 dark:bg-gray-800">
            <tr>
              <th class="px-4 py-2 text-left font-medium text-gray-500 dark:text-gray-400">Timestamp (UK)</th>
              <th class="px-4 py-2 text-left font-medium text-gray-500 dark:text-gray-400">Event</th>
              <th class="px-4 py-2 text-left font-medium text-gray-500 dark:text-gray-400">Actor</th>
              <th class="px-4 py-2 text-left font-medium text-gray-500 dark:text-gray-400">Target</th>
              <th class="px-4 py-2 text-left font-medium text-gray-500 dark:text-gray-400">What changed</th>
              <th class="px-4 py-2 text-left font-medium text-gray-500 dark:text-gray-400">IP address</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white dark:divide-gray-700 dark:bg-gray-900">
            <% entries.forEach(function (entry) { %>
            <tr>
              <td class="whitespace-nowrap px-4 py-2">
                <%= new Date(entry.created_at).toLocaleString('en-GB', { timeZone: 'Europe/London', dateStyle: 'medium', timeStyle: 'medium' }) %>
              </td>
              <td class="whitespace-nowrap px-4 py-2"><%= entry.event_type %></td>
              <td class="whitespace-nowrap px-4 py-2"><%= entry.actor_username ?? '—' %></td>
              <td class="px-4 py-2"><%= entry.target ?? '—' %></td>
              <td class="max-w-xs px-4 py-2 text-xs text-gray-600 dark:text-gray-400"><%= entry.details ?? '—' %></td>
              <td class="whitespace-nowrap px-4 py-2"><%= entry.ip_address ?? '—' %></td>
            </tr>
            <% }) %> <% if (entries.length === 0) { %>
            <tr>
              <td colspan="6" class="px-4 py-6 text-center text-gray-500 dark:text-gray-400">No matching events.</td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </body>
</html>
