<!doctype html>
<html lang="en" class="h-full <%= locals.currentUser.theme_preference === 'dark' ? 'dark' : '' %>">
  <head>
    <%- include('../partials/head', { title: app ? 'Edit App' : 'Add App' }) %>
  </head>
  <body class="min-h-full bg-gray-50 font-sans text-gray-900 dark:bg-gray-950 dark:text-gray-100">
    <%- include('../partials/nav', { activeNav: 'admin' }) %>

    <main class="mx-auto max-w-2xl px-4 py-8">
      <a href="/admin/apps" class="mb-4 inline-block text-sm text-brand-accent">&larr; Back to Manage Apps</a>
      <h2 class="mb-6 text-lg font-semibold"><%= app ? 'Edit App' : 'Add App' %></h2>

      <form
        method="POST"
        action="<%= app ? '/admin/apps/' + app.id : '/admin/apps' %>"
        class="space-y-5 rounded-xl border border-gray-200 bg-white p-6 dark:border-gray-700 dark:bg-gray-800"
      >
        <div>
          <label for="name" class="form-label">Name</label>
          <input id="name" name="name" type="text" required class="form-input" value="<%= app ? app.name : '' %>" />
        </div>

        <div>
          <label for="description" class="form-label">Short description</label>
          <textarea id="description" name="description" rows="2" class="form-input"><%= app ? app.description : '' %></textarea>
        </div>

        <div>
          <label for="url" class="form-label">URL</label>
          <input id="url" name="url" type="text" class="form-input" value="<%= app ? app.url : '' %>" placeholder="https://your-tool.onrender.com" />
        </div>

        <div>
          <label class="form-label">Icon</label>
          <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-lg border border-gray-300 text-xl dark:border-gray-600" id="icon-preview"><%= app ? app.icon : '🔧' %></span>
            <input id="icon-input" name="icon" type="text" class="form-input" value="<%= app ? app.icon : '🔧' %>" oninput="document.getElementById('icon-preview').textContent = this.value" />
          </div>
          <div id="icon-picker" class="mt-2 flex flex-wrap gap-1.5"></div>
        </div>

        <div>
          <label for="categoryId" class="form-label">Category</label>
          <select id="categoryId" name="categoryId" required class="form-input">
            <% categories.forEach(function (category) { %>
            <option value="<%= category.id %>" <%= app && app.category_id === category.id ? 'selected' : '' %>>
              <%= category.name %>
            </option>
            <% }) %>
          </select>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="status-select" class="form-label">Status</label>
            <select id="status-select" name="status" class="form-input">
              <% ['live', 'beta', 'internal'].forEach(function (status) { %>
              <option value="<%= status %>" <%= app && app.status === status ? 'selected' : '' %>><%= status %></option>
              <% }) %>
            </select>
          </div>
          <div>
            <label for="visibility-select" class="form-label">Visibility</label>
            <select id="visibility-select" name="visibility" class="form-input">
              <option value="all" <%= !app || app.visibility === 'all' ? 'selected' : '' %>>All users</option>
              <option value="restricted" <%= app && app.visibility === 'restricted' ? 'selected' : '' %>>Restricted</option>
            </select>
          </div>
        </div>

        <p id="internal-notice" class="hidden rounded-lg bg-amber-50 px-3 py-2 text-xs text-amber-800 dark:bg-amber-900/30 dark:text-amber-300">
          Apps with status "internal" are automatically hidden from non-admins, regardless of the visibility setting.
        </p>

        <div id="access-section" class="hidden">
          <label class="form-label">Grant access to</label>
          <div class="max-h-48 space-y-1 overflow-y-auto rounded-lg border border-gray-300 p-3 dark:border-gray-600">
            <% users.forEach(function (u) { %>
            <label class="flex items-center gap-2 text-sm">
              <input
                type="checkbox"
                name="userIds"
                value="<%= u.id %>"
                <%= grantedUserIds.includes(u.id) ? 'checked' : '' %>
              />
              <%= u.username %>
            </label>
            <% }) %>
          </div>
        </div>

        <div>
          <label for="notes" class="form-label">What's new (optional)</label>
          <input id="notes" name="notes" type="text" class="form-input" value="<%= app && app.notes ? app.notes : '' %>" />
        </div>

        <label class="flex items-center gap-2 text-sm">
          <input type="checkbox" name="isActive" <%= !app || app.is_active ? 'checked' : '' %> />
          Active (visible on the dashboard)
        </label>

        <div class="flex justify-end gap-2">
          <a href="/admin/apps" class="btn-secondary">Cancel</a>
          <button type="submit" class="btn-primary"><%= app ? 'Save changes' : 'Create app' %></button>
        </div>
      </form>
    </main>

    <script src="/js/appForm.js"></script>
  </body>
</html>
