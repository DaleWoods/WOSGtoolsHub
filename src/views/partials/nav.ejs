<%
  const user = locals.currentUser;
  const currentPath = typeof activeNav !== 'undefined' ? activeNav : '';
%>
<header class="border-b border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-900">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-3 px-4 py-6 text-center">
    <img src="/images/logo-placeholder.svg" alt="WOSG logo" class="h-10 w-10" />
    <h1 class="text-xl font-semibold text-gray-900 dark:text-gray-50">WOSG Tools Hub</h1>

    <% if (user) { %>
    <nav class="mt-2 flex flex-wrap items-center justify-center gap-2">
      <a href="/" class="admin-nav-link <%= currentPath === 'dashboard' ? 'active' : '' %>">Dashboard</a>
      <% if (user.role === 'admin') { %>
      <a href="/admin/apps" class="admin-nav-link <%= currentPath.startsWith('admin') ? 'active' : '' %>">Admin</a>
      <% } %>
      <button
        id="theme-toggle"
        type="button"
        aria-pressed="<%= user.theme_preference === 'dark' %>"
        class="admin-nav-link"
        title="Toggle light/dark mode"
      >
        <%= user.theme_preference === 'dark' ? '☀️ Light' : '🌙 Dark' %>
      </button>
      <form method="POST" action="/logout" class="inline">
        <button type="submit" class="admin-nav-link">Sign out</button>
      </form>
    </nav>
    <% } %>
  </div>
</header>
<script src="/js/theme.js"></script>
