{
  "name": "wosg-tools-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Internal landing page / directory for WOSG's Claude Code tools",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build:css": "tailwindcss -i ./src/public/css/input.css -o ./src/public/css/output.css --minify",
    "copy:assets": "mkdir -p dist/views dist/public && cp -r src/views/. dist/views/ && cp -r src/public/. dist/public/",
    "build": "npm run build:css && tsc -p tsconfig.json && npm run copy:assets",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.4.2",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.1",
    "@types/node": "^22.10.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2"
  }
}
