# Postgres connection string. On Render this is auto-wired from the blueprint's database service.
DATABASE_URL=postgres://wosg_hub:wosg_hub@localhost:5432/wosg_hub

# Session cookie signing secret — set a long random value in production.
SESSION_SECRET=change-me-to-a-long-random-string

# First-admin bootstrap. Used once on startup if the users table is empty.
ADMIN_USERNAME=dale
ADMIN_PASSWORD=ChangeMe123

# Comma-separated list of allowed client IPs / CIDR ranges (WOSG office/VPN egress).
# Requests from outside this list get a generic 404. Leave blank to allow all
# (e.g. for local development) — never leave blank in production.
ALLOWED_IP_RANGES=

# Port the Node server listens on (Render sets PORT automatically).
PORT=3000

# Node environment.
NODE_ENV=development
